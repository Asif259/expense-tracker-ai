{
  "name": "ledgerly-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:shared && npm run build --workspaces",
    "build:shared": "npm run build --workspace=@ledgerly/shared-types",
    "build:api": "npm run build:shared && npm run build --workspace=api",
    "build:web": "npm run build:shared && npm run build --workspace=web",
    "start:api": "npm run start:prod --workspace=api",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
