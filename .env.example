# ==============================================================================
# Ledgerly Environment Configuration (Placeholders only)
# Copy to .env or .env.local in respective apps/ directories. Never commit secrets.
# ==============================================================================

# Supabase Public & Server URLs
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (Keep strictly server-side / NestJS only)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# NestJS Server Configuration
PORT=3001
API_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3000

# Next.js Application
NEXT_PUBLIC_API_URL=http://localhost:3001

# Groq AI Service (Server-side only)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b
